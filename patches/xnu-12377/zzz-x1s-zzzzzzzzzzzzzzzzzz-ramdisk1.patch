diff --git a/iokit/bsddev/IOKitBSDInit.cpp b/iokit/bsddev/IOKitBSDInit.cpp
index 2bbd161..af13645 100644
--- a/iokit/bsddev/IOKitBSDInit.cpp
+++ b/iokit/bsddev/IOKitBSDInit.cpp
@@ -791,6 +791,17 @@ IOFindBSDRoot( char * rootName, unsigned int rootNameSize,
 #endif /* __LP64__ */
 				(void)mdevadd(-1, ml_static_ptovirt(ramdParms[0]) >> 12, (unsigned int) (ramdParms[1] >> 12), 0);        /* Initialize it and pass back the device number */
 			}
+			/*
+			 * x1s (as Jesvi's redwood): a second image the loader may have left in memory becomes /dev/md1, a volume
+			 * for user space to mount (the small boot image with init and the launchd jobs), never the root.
+			 */
+			data = (OSData *)regEntry->getProperty("RAMDisk1");
+			if (data && data->getLength() >= 2 * sizeof(uintptr_t)) {
+				uintptr_t *ramd1Parms = (uintptr_t *)data->getBytesNoCopy();
+				if (ramd1Parms[1] <= (((uint64_t)UINT_MAX) << 12)) {
+					(void)mdevadd(1, ml_static_ptovirt(ramd1Parms[0]) >> 12, (unsigned int) (ramd1Parms[1] >> 12), 0);
+				}
+			}
 			regEntry->release();                                                            /* Toss the entry */
 		}
 	}
