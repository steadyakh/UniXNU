+	uint64_t        fLatchTime;                     /* when the scaler's last frame was seen taken: the panel's phase */
+	bool            fSwapQueuedUse[SWAP_QUEUE];     /* the slot's surface was counted in use when queued */
+	uint32_t        fStatSwapWaitTimeouts;
