diff --git a/iokit/Kernel/MiniIOMobileFramebuffer.cpp b/iokit/Kernel/MiniIOMobileFramebuffer.cpp
index 3385839..f21ab6e 100644
--- a/iokit/Kernel/MiniIOMobileFramebuffer.cpp
+++ b/iokit/Kernel/MiniIOMobileFramebuffer.cpp
@@ -4563,15 +4563,23 @@ MiniIOMobileFramebufferStart(IOService * provider)
 {
 	IOMobileFramebuffer * fb = OSTypeAlloc(IOMobileFramebuffer);
 
+	IOLog("x1s fb: start (provider %p)
+", provider);
 	if (fb == NULL || !fb->init() || !fb->attach(provider)) {
+		IOLog("x1s fb: alloc/init/attach failed (fb %p)
+", fb);
 		OSSafeReleaseNULL(fb);
 		return;
 	}
 	if (fb->start(provider)) {
+		IOLog("x1s fb: started
+");
 		publishDisplayNode();
 		publishBacklight(fb);
 		publishAccelerator(provider);
 	} else {
+		IOLog("x1s fb: start() failed
+");
 		fb->detach(provider);
 	}
 	fb->release();
