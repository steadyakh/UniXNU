--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -1178,6 +1178,214 @@
 }
 
 /*
+ * x1s (Galaxy S20, Exynos 990: Cortex-A55/A76, ARMv8.2): instructions of Apple's iOS 27 userland that these cores do
+ * not have, emulated here instead of killing the process. The arm64e code on disk is lowered once on the PC
+ * (tools/ios27/lower_pac.py in the hakios-s20 project); this covers what that cannot: code generated at run time
+ * (JavaScriptCore's JIT), the one LDRAB in libsystem_m whose offset fits no plain load, and the ARMv8.3+ instructions
+ * the A16 userland uses (list after ios-guacamole's sleh.c emulation, OnePlus 7 Pro, same CPU generation):
+ *   pointer authentication (no key here, so nothing is ever signed: PAC/AUT/XPAC leave the register, PACGA gives 0
+ *   like the lowering, the authenticated branches and loads are the plain ones), LDAPUR/STLUR (RCpc 2), CFINV,
+ *   RMIF, SETF8/16 (FlagM), SB, DIT, FJCVTZS (JavaScript's double -> int32).
+ * Anything else is logged (the first 64) and gets the usual EXC_BAD_INSTRUCTION, so new ones can be found.
+ */
+#define X1S_PSR_N (1u << 31)
+#define X1S_PSR_Z (1u << 30)
+#define X1S_PSR_C (1u << 29)
+#define X1S_PSR_V (1u << 28)
+static unsigned x1s_undef_logged;
+
+static uint64_t
+x1s_xreg(arm_saved_state_t *state, unsigned r, bool sp)
+{
+	if (r == 31) {
+		return sp ? (uint64_t)get_saved_state_sp(state) : 0;
+	}
+	return (uint64_t)get_saved_state_reg(state, r);
+}
+
+static void
+x1s_set_xreg(arm_saved_state_t *state, unsigned r, uint64_t v)
+{
+	if (r != 31) {
+		set_user_saved_state_reg(state, r, (register_t)v);
+	}
+}
+
+/* true: handled (the PC is moved on or set); false: not ours, or a bad address (the caller raises the exception) */
+static bool
+x1s_emulate(arm_saved_state_t *state, uint32_t instr)
+{
+	uint64_t pc = (uint64_t)get_saved_state_pc(state);
+	uint32_t cpsr = get_saved_state_cpsr(state);
+
+	if (!PSR64_IS_USER64(cpsr)) {
+		return false;
+	}
+	/* BRAA(Z)/BRAB(Z), BLRAA(Z)/BLRAB(Z), RETAA/RETAB */
+	if ((instr & 0xfe1ff800) == 0xd61f0800) {
+		unsigned z = (instr >> 24) & 1, opc = (instr >> 21) & 7, rn = (instr >> 5) & 31, rm = instr & 31;
+		uint64_t target;
+		if (opc == 2 && !z && rn == 31 && rm == 31) {
+			target = x1s_xreg(state, 30, false);
+		} else if (opc <= 1 && (z || rm == 31)) {
+			target = x1s_xreg(state, rn, false);
+			if (opc == 1) {
+				x1s_set_xreg(state, 30, pc + 4);
+			}
+		} else {
+			return false;
+		}
+		set_saved_state_pc(state, (register_t)target);
+		return true;
+	}
+	/* PACIA..AUTDB, the Z forms, XPACI/XPACD: the register keeps its value */
+	if ((instr & 0xffff0000) == 0xdac10000 && ((instr >> 10) & 0x3f) <= 0x11) {
+		goto next;
+	}
+	/* PACGA Xd, Xn, Xm|SP: 0, as the lowered code on disk computes it */
+	if ((instr & 0xffe0fc00) == 0x9ac03000) {
+		x1s_set_xreg(state, instr & 31, 0);
+		goto next;
+	}
+	/* LDRAA/LDRAB Xt, [Xn|SP, #simm10*8]{!} */
+	if ((instr & 0xff200400) == 0xf8200400) {
+		unsigned rn = (instr >> 5) & 31, rt = instr & 31, w = (instr >> 11) & 1;
+		int64_t off = (int64_t)((((instr >> 22) & 1) << 9) | ((instr >> 12) & 0x1ff));
+		off = (off << 54) >> 54;
+		user_addr_t addr = (user_addr_t)(x1s_xreg(state, rn, true) + (uint64_t)(off * 8));
+		uint64_t v;
+		if (copyin(addr, &v, 8) != 0) {
+			return false;
+		}
+		if (w) {
+			if (rn == 31) {
+				set_saved_state_sp(state, (register_t)addr);
+			} else {
+				x1s_set_xreg(state, rn, addr);
+			}
+		}
+		x1s_set_xreg(state, rt, v);
+		goto next;
+	}
+	/* LDAPUR*, STLUR (size 011001 opc 0 imm9 00 Rn Rt): acquire/release with an unscaled offset */
+	if ((instr & 0x3f200c00) == 0x19000000) {
+		unsigned size = instr >> 30, opc = (instr >> 22) & 3, rn = (instr >> 5) & 31, rt = instr & 31;
+		int64_t off = (int64_t)((instr >> 12) & 0x1ff);
+		off = (off << 55) >> 55;
+		user_addr_t addr = (user_addr_t)(x1s_xreg(state, rn, true) + (uint64_t)off);
+		unsigned bytes = 1u << size;
+		uint64_t v = 0;
+		if (opc == 0) {                         /* STLUR */
+			v = x1s_xreg(state, rt, false);
+			__asm__ volatile ("dmb ish" ::: "memory");
+			if (copyout(&v, addr, bytes) != 0) {
+				return false;
+			}
+		} else {
+			if ((opc >= 2 && size == 3) || (opc == 3 && size == 2)) {
+				return false;                   /* unallocated */
+			}
+			if (copyin(addr, &v, bytes) != 0) {
+				return false;
+			}
+			__asm__ volatile ("dmb ish" ::: "memory");
+			if (opc >= 2) {                     /* LDAPURS: sign-extend to 64 (opc 2) or 32 bits (opc 3) */
+				unsigned shift = 64 - 8 * bytes;
+				v = (uint64_t)(((int64_t)(v << shift)) >> shift);
+				if (opc == 3) {
+					v &= 0xffffffffull;
+				}
+			}
+			x1s_set_xreg(state, rt, v);
+		}
+		goto next;
+	}
+	/* CFINV */
+	if (instr == 0xd500401f) {
+		set_saved_state_cpsr(state, cpsr ^ X1S_PSR_C);
+		goto next;
+	}
+	/* RMIF Xn, #shift, #mask */
+	if ((instr & 0xffe07c10) == 0xba000400) {
+		unsigned sh = (instr >> 15) & 63, mask = instr & 15;
+		uint64_t x = x1s_xreg(state, (instr >> 5) & 31, false);
+		uint64_t r = sh ? (x >> sh) | (x << (64 - sh)) : x;
+		uint32_t nzcv = (uint32_t)(r & 15) << 28, m = mask << 28;
+		set_saved_state_cpsr(state, (cpsr & ~m) | (nzcv & m));
+		goto next;
+	}
+	/* SETF8 / SETF16 Wn */
+	if ((instr & 0xfffffc1f) == 0x3a00080d || (instr & 0xfffffc1f) == 0x3a00480d) {
+		unsigned bits = (instr & 0x4000) ? 16 : 8;
+		uint32_t w = (uint32_t)x1s_xreg(state, (instr >> 5) & 31, false);
+		uint32_t n = (w >> (bits - 1)) & 1, z = (w & ((1u << bits) - 1)) == 0, v = ((w >> bits) & 1) ^ n;
+		cpsr &= ~(X1S_PSR_N | X1S_PSR_Z | X1S_PSR_V);
+		cpsr |= (n ? X1S_PSR_N : 0) | (z ? X1S_PSR_Z : 0) | (v ? X1S_PSR_V : 0);
+		set_saved_state_cpsr(state, cpsr);
+		goto next;
+	}
+	/* SB: a speculation barrier; the trap itself is one */
+	if (instr == 0xd50330ff) {
+		goto next;
+	}
+	/* DIT: MSR DIT, #imm (ignored), MSR DIT, Xt (ignored), MRS Xt, DIT (0) */
+	if ((instr & 0xfffff0ff) == 0xd503405f || (instr & 0xffffffe0) == 0xd51b42a0) {
+		goto next;
+	}
+	if ((instr & 0xffffffe0) == 0xd53b42a0) {
+		x1s_set_xreg(state, instr & 31, 0);
+		goto next;
+	}
+	/* FJCVTZS Wd, Dn (JSCVT): double -> int32 as JavaScript's ToInt32, Z = exact */
+	if ((instr & 0xfffffc00) == 0x1e7e0000 && current_thread()->machine.uNeon != NULL) {
+		arm_neon_saved_state64_t *ns = neon_state64(current_thread()->machine.uNeon);
+		uint64_t bits = (uint64_t)ns->v.q[(instr >> 5) & 31];
+		unsigned exp = (unsigned)((bits >> 52) & 0x7ff);
+		uint64_t mant = bits & ((1ull << 52) - 1);
+		bool neg = (bits >> 63) != 0, exact = false;
+		uint32_t r = 0;
+		if (exp == 0x7ff) {
+			r = 0;
+		} else if (exp == 0) {
+			exact = mant == 0 && !neg;
+		} else {
+			mant |= 1ull << 52;
+			int sh = (int)exp - 1075;
+			uint64_t ip;
+			bool frac = false, big = false;
+			if (sh >= 0) {
+				ip = sh >= 64 ? 0 : mant << sh;
+				big = sh > 10;
+			} else if (sh <= -64) {
+				ip = 0;
+				frac = true;
+			} else {
+				ip = mant >> -sh;
+				frac = (mant & ((1ull << -sh) - 1)) != 0;
+			}
+			r = (uint32_t)ip;
+			if (neg) {
+				r = (uint32_t)-r;
+			}
+			exact = !frac && !big && (neg ? ip <= 0x80000000ull : ip <= 0x7fffffffull) && !(neg && ip == 0);
+		}
+		x1s_set_xreg(state, instr & 31, r);
+		cpsr &= ~(X1S_PSR_N | X1S_PSR_Z | X1S_PSR_C | X1S_PSR_V);
+		cpsr |= exact ? X1S_PSR_Z : 0;
+		set_saved_state_cpsr(state, cpsr);
+		goto next;
+	}
+	if (x1s_undef_logged < 64) {
+		x1s_undef_logged++;
+		printf("x1s: undefined instruction %08x at %llx\n", instr, pc);
+	}
+	return false;
+next:
+	set_saved_state_pc(state, (register_t)(pc + 4));
+	return true;
+}
+
+/*
  * Uncategorized exceptions are a catch-all for general execution errors.
  * ARM64_TODO: For now, we assume this is for undefined instruction exceptions.
  */
@@ -1252,6 +1460,11 @@
 		} else {
 			panic("Undefined kernel instruction: pc=%p instr=%x", (void*)get_saved_state_pc(state), instr);
 		}
+	}
+
+	/* x1s: ARMv8.3+ instructions of the iOS 27 userland that the A55/A76 lack */
+	if (x1s_emulate(state, instr)) {
+		return;
 	}
 
 	/*
