diff --git a/bsd/kern/kern_proc.c b/bsd/kern/kern_proc.c
index dfb3a45..f7387b6 100644
--- a/bsd/kern/kern_proc.c
+++ b/bsd/kern/kern_proc.c
@@ -6921,3 +6921,63 @@ SYSCTL_UINT(_kern, OID_AUTO, total_corpses_allowed,
     CTLFLAG_RW | CTLFLAG_LOCKED, &total_corpses_allowed, DEFAULT_TOTAL_CORPSES_ALLOWED,
     "Maximum in-flight corpse count");
 #endif /* DEVELOPMENT || DEBUG */
+
+/*
+ * x1s: boot-arg x1s_ps=N: every N seconds the running processes on the console, as "x1s ps:" lines of
+ * about 150 characters (bring-up: which daemons are alive, not only which crash).
+ */
+#include <pexpert/pexpert.h>
+#include <kern/clock.h>
+extern kern_return_t kernel_thread_start(thread_continue_t continuation, void *parameter, thread_t *new_thread);
+static int x1s_ps_secs;
+static char x1s_ps_line[176];
+static int x1s_ps_len;
+
+static void
+x1s_ps_flush(void)
+{
+	if (x1s_ps_len > 0) {
+		printf("x1s ps:%s\n", x1s_ps_line);
+		x1s_ps_len = 0;
+		x1s_ps_line[0] = 0;
+	}
+}
+
+static int
+x1s_ps_one(proc_t p, __unused void *arg)
+{
+	char item[32];
+	int n = snprintf(item, sizeof(item), " %s:%d", p->p_comm, proc_getpid(p));
+	if (n > 0) {
+		if (x1s_ps_len + n >= 150) {
+			x1s_ps_flush();
+		}
+		strlcpy(x1s_ps_line + x1s_ps_len, item, sizeof(x1s_ps_line) - x1s_ps_len);
+		x1s_ps_len += n;
+	}
+	return PROC_RETURNED;
+}
+
+static void
+x1s_ps_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	for (;;) {
+		delay_for_interval((uint32_t)x1s_ps_secs * 1000, NSEC_PER_MSEC);
+		printf("x1s ps: --- running processes ---\n");
+		proc_iterate(PROC_ALLPROCLIST, x1s_ps_one, NULL, NULL, NULL);
+		x1s_ps_flush();
+	}
+}
+
+void x1s_ps_start(void);
+void
+x1s_ps_start(void)
+{
+	thread_t th;
+	if (!PE_parse_boot_argn("x1s_ps", &x1s_ps_secs, sizeof(x1s_ps_secs)) || x1s_ps_secs < 5) {
+		return;
+	}
+	if (kernel_thread_start(x1s_ps_thread, NULL, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+	}
+}
