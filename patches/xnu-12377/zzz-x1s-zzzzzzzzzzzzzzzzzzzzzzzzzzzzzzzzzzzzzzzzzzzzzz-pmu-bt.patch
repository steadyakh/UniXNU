diff --git a/bsd/kern/kern_exit.c b/bsd/kern/kern_exit.c
index b5633e4..d2944a9 100644
--- a/bsd/kern/kern_exit.c
+++ b/bsd/kern/kern_exit.c
@@ -2037,6 +2037,17 @@ proc_prepareexit(proc_t p, int rv, boolean_t perf_notify)
 	task_t task = proc_task(p);
 
 
+#if __arm64__
+	/* x1s: a stack for every process killed by a crash-type signal (bring-up) */
+	if (p == current_proc() && WIFSIGNALED(rv)) {
+		int x1s_sig = WTERMSIG(rv);
+		if (x1s_sig == SIGABRT || x1s_sig == SIGTRAP || x1s_sig == SIGSEGV || x1s_sig == SIGBUS ||
+		    x1s_sig == SIGILL || x1s_sig == SIGFPE || x1s_sig == SIGSYS) {
+			extern void x1s_user_backtrace(const char *name, int pid, int sig);
+			x1s_user_backtrace(proc_best_name(p), proc_getpid(p), x1s_sig);
+		}
+	}
+#endif
 	if (p->p_crash_behavior != 0 || p == initproc) {
 		proc_handle_critical_exit(p, rv);
 	}
