diff --git a/osfmk/kern/exception.c b/osfmk/kern/exception.c
index fd26264..29941ae 100644
--- a/osfmk/kern/exception.c
+++ b/osfmk/kern/exception.c
@@ -89,6 +89,7 @@
 
 #include <vm/vm_map_xnu.h>
 #include <vm/vm_map.h>
+#include <vm/vm_shared_region_xnu.h>
 #include <sys/reason.h>
 #include <security/mac_mach_internal.h>
 #include <string.h>
@@ -915,6 +916,44 @@ maybe_unrecoverable_exception_triage(
  *	Returns:
  *		KERN_SUCCESS if exception is handled by any of the handlers.
  */
+/*
+ * x1s: one console line with the crashing thread's user frame-pointer chain and the shared cache slide,
+ * for processes that die by a fatal signal without a Mach exception (abort, os_crash ...). Called from
+ * proc_prepareexit (bsd/kern/kern_exit.c) in the dying thread's context.
+ */
+extern int copyin(const user_addr_t uaddr, void *kaddr, size_t len);
+void x1s_user_backtrace(const char *name, int pid, int sig);
+void
+x1s_user_backtrace(const char *name, int pid, int sig)
+{
+	thread_t thread = current_thread();
+	task_t task = current_task();
+	struct arm_saved_state *st = get_user_regs(thread);
+	char buf[480];
+	int n;
+
+	if (st == NULL || task == kernel_task) {
+		return;
+	}
+	uint64_t fp = get_saved_state_fp(st);
+	uint64_t slide = task->shared_region ? (uint64_t)task->shared_region->sr_slide : 0;
+	n = snprintf(buf, sizeof(buf), "x1s bt: %s[%d] sig %d slide 0x%llx pc 0x%llx lr 0x%llx fr",
+	    name, pid, sig, slide, (unsigned long long)get_saved_state_pc(st),
+	    (unsigned long long)get_saved_state_lr(st));
+	for (int i = 0; i < 16 && fp != 0 && n > 0 && n < (int)sizeof(buf) - 24; i++) {
+		uint64_t fr[2];
+		if (copyin((user_addr_t)fp, fr, sizeof(fr)) != 0) {
+			break;
+		}
+		n += snprintf(buf + n, sizeof(buf) - n, " %llx", (unsigned long long)(fr[1] & 0x0000007fffffffffULL));
+		if (fr[0] <= fp) {
+			break;
+		}
+		fp = fr[0];
+	}
+	printf("%s\n", buf);
+}
+
 int debug4k_panic_on_exception = 0;
 kern_return_t
 exception_triage(
