diff --git a/iokit/Kernel/MiniAppleKeyStore.cpp b/iokit/Kernel/MiniAppleKeyStore.cpp
index 39738f7..8f2d4dd 100644
--- a/iokit/Kernel/MiniAppleKeyStore.cpp
+++ b/iokit/Kernel/MiniAppleKeyStore.cpp
@@ -570,6 +570,87 @@ AppleKeyStoreUserClient::externalMethod(uint32_t selector, IOExternalMethodArgum
 
 /* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
 
+/*
+ * x1s: IOWatchdog stand-in. iOS's watchdogd looks the service up by class (IOServiceMatching("IOWatchdog")),
+ * opens it (type 1) and crashes on purpose when it is missing. Selector 0 answers 0 = "userspace monitoring
+ * disabled": watchdogd then skips the PMU boot stage (boot-arg -wdt_no_pmu), sleeps and exits 0, and
+ * launchd does not restart it (KeepAlive SuccessfulExit=false). The S20 has no such hardware watchdog here.
+ */
+class IOWatchdog : public IOService
+{
+	OSDeclareDefaultStructors(IOWatchdog);
+public:
+	virtual bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IOWatchdog, IOService);
+
+bool
+IOWatchdog::start(IOService * provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "IOWatchdogUserClient");
+	registerService();
+	return true;
+}
+
+class IOWatchdogUserClient : public IOUserClient
+{
+	OSDeclareDefaultStructors(IOWatchdogUserClient);
+public:
+	virtual IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments * args,
+	    IOExternalMethodDispatch * dispatch, OSObject * target, void * reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IOWatchdogUserClient, IOUserClient);
+
+IOReturn
+IOWatchdogUserClient::clientClose(void)
+{
+	if (!isInactive()) {
+		terminate();
+	}
+	return kIOReturnSuccess;
+}
+
+IOReturn
+IOWatchdogUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments * args,
+    IOExternalMethodDispatch * dispatch, OSObject * target, void * reference)
+{
+	static int logged;
+	if (logged < 8) {
+		logged++;
+		IOLog("x1s wdt: pid %d sel %u in %u out %u\n", proc_selfpid(),
+		    selector, args->scalarInputCount, args->scalarOutputCount);
+	}
+	for (uint32_t i = 0; i < args->scalarOutputCount; i++) {
+		args->scalarOutput[i] = 0;
+	}
+	return kIOReturnSuccess;
+}
+
+static void
+x1s_watchdog_start(void)
+{
+	IOService * resources = IOService::getResourceService();
+	IOWatchdog * wd = OSTypeAlloc(IOWatchdog);
+
+	if (resources == NULL || wd == NULL || !wd->init() || !wd->attach(resources)) {
+		OSSafeReleaseNULL(wd);
+		IOLog("x1s wdt: cannot create the service\n");
+		return;
+	}
+	if (!wd->start(resources)) {
+		wd->detach(resources);
+	} else {
+		IOLog("x1s wdt: IOWatchdog stand-in registered\n");
+	}
+	wd->release();
+}
+
 void
 MiniAppleKeyStoreStart(void)
 {
@@ -603,6 +684,7 @@ MiniAppleKeyStoreStart(void)
 		store->detach(resources);
 	}
 	store->release();
+	x1s_watchdog_start();
 }
 
