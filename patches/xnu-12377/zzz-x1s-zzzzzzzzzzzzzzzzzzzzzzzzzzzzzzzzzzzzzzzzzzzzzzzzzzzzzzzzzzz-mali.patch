+
+/*
+ * Whose GPU this is. Everything below asks the GPU's driver through these: hakios.adreno.c's for redwood's Adreno
+ * (the msm interface), hakios.mali.c's for the Galaxy S20's Mali-G77 (the panfrost interface, panfrostRequest()).
+ */
+struct gpu_backend {
+	bool (*ready)(void);
+	bool (*parameter)(uint32_t which, uint64_t * value);
+	uint64_t (*address)(uint64_t size);
+	void (*address_free)(uint64_t address, uint64_t size);
+	bool (*map)(uint64_t address, uint64_t phys, bool read_only);
+	void (*mapped)(void);
+	void (*unmap)(uint64_t address, uint64_t size);
+	void (*to_memory)(void * start, uint64_t size);
+	uint32_t (*submit)(const uint64_t * addresses, const uint32_t * words, uint32_t count);
+	bool (*done)(uint32_t fence);
+	uint32_t (*last)(void);
+	void (*worked)(uint64_t * microseconds, uint32_t * submissions, uint32_t by[7]);
+	void (*report)(const char * why);
+	void (*stop)(void);
+};
+static const struct gpu_backend gAdreno = {
+	hakios_gpu_ready, hakios_gpu_parameter, hakios_gpu_address, hakios_gpu_address_free, hakios_gpu_map,
+	hakios_gpu_mapped, hakios_gpu_unmap, hakios_gpu_to_memory, hakios_gpu_submit, hakios_gpu_done, hakios_gpu_last,
+	hakios_gpu_worked, hakios_gpu_report, hakios_gpu_stop,
+};
+static const struct gpu_backend gMali = {
+	hakios_mali_gpu_ready, hakios_mali_gpu_parameter, hakios_mali_gpu_address, hakios_mali_gpu_address_free,
+	hakios_mali_gpu_map, hakios_mali_gpu_mapped, hakios_mali_gpu_unmap, hakios_mali_gpu_to_memory,
+	hakios_mali_gpu_submit, hakios_mali_gpu_done, hakios_mali_gpu_last, hakios_mali_gpu_worked,
+	hakios_mali_gpu_report, hakios_mali_gpu_stop,
+};
+static const struct gpu_backend * gb = &gAdreno;
+
+/* Linux's include/uapi/drm/panfrost_drm.h: the Mali's requests (DRM_COMMAND_BASE + n) and structures */
+enum {
+	kPanfrostSubmit         = 0x40,
+	kPanfrostWaitBo         = 0x41,
+	kPanfrostCreateBo       = 0x42,
+	kPanfrostMmapBo         = 0x43,
+	kPanfrostGetParam       = 0x44,
+	kPanfrostGetBoOffset    = 0x45,
+	kPanfrostMadvise        = 0x48,
+	kPanfrostSetLabelBo     = 0x49,
+};
+struct panfrost_submit {
+	uint64_t jc, in_syncs;
+	uint32_t in_sync_count, out_sync;               /* out_sync: the fence goes back here (tools/mesa/hakios-drm) */
+	uint64_t bo_handles;
+	uint32_t bo_handle_count, requirements;
+};
+struct panfrost_wait_bo {
+	uint32_t handle, pad;
+	int64_t timeout_ns;
+};
+struct panfrost_create_bo {
+	uint32_t size, flags, handle, pad;
+	uint64_t offset;
+};
+struct panfrost_mmap_bo {
+	uint32_t handle, flags;
+	uint64_t offset;
+};
+struct panfrost_get_param {
+	uint32_t param, pad;
+	uint64_t value;
+};
+struct panfrost_get_bo_offset {
+	uint32_t handle, pad;
+	uint64_t offset;
+};
+struct panfrost_madvise {
+	uint32_t handle, madv, retained;
+};
+
+/* Linux's include/uapi/drm/msm_drm.h and drm.h: the requests' numbers and structures. */
+enum {
+	kDrmGemClose            = 0x09,
+	kMsmGetParam            = 0x40,
+	kMsmSetParam            = 0x41,
+	kMsmGemNew              = 0x42,
+	kMsmGemInfo             = 0x43,
+	kMsmGemCpuPrep          = 0x44,
+	kMsmGemCpuFini          = 0x45,
+	kMsmGemSubmit           = 0x46,
+	kMsmWaitFence           = 0x47,
+	kMsmGemMadvise          = 0x48,
+	kMsmSubmitQueueNew      = 0x4a,
+	kMsmSubmitQueueClose    = 0x4b,
+	kMsmSubmitQueueQuery    = 0x4c,
+	kHakiosUserMemory      = 0x7d,         /* ours: pages of the caller's own as a buffer (Linux's userptr) */
+	kHakiosSurface         = 0x7e,         /* ours: an IOSurface's memory as a buffer */
+	kHakiosShow            = 0x7f,         /* ours: pixels of the caller's onto the panel, to see a test's result */
+};
+
+struct msm_timespec {
+	int64_t seconds, nanoseconds;           /* of the clock that goes on while the machine sleeps */
+};
+struct msm_param {
+	uint32_t pipe, param;
+	uint64_t value;
+	uint32_t len, pad;
+};
+struct msm_gem_new {
+	uint64_t size;
+	uint32_t flags, handle;
+};
