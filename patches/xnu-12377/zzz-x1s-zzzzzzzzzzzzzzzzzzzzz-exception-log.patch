diff --git a/osfmk/kern/exception.c b/osfmk/kern/exception.c
index 29d7dbe..553a1c3 100644
--- a/osfmk/kern/exception.c
+++ b/osfmk/kern/exception.c
@@ -94,6 +94,10 @@
 #include <string.h>
 
 #include <pexpert/pexpert.h>
+#if __arm64__
+#include <arm/thread.h>
+#include <arm64/proc_reg.h>
+#endif
 
 #include <os/log.h>
 #include <os/system_event_log.h>
@@ -923,6 +927,23 @@ exception_triage(
 
 	assert(codeCnt > 0);
 
+#if __arm64__
+	/* x1s: where a user process crashes (bring-up) */
+	if (task != kernel_task && (exception == EXC_BAD_ACCESS || exception == EXC_BAD_INSTRUCTION ||
+	    exception == EXC_ARITHMETIC || exception == EXC_BREAKPOINT || exception == EXC_GUARD)) {
+		struct arm_saved_state *x1s_st = get_user_regs(thread);
+		void *x1s_p = get_bsdtask_info(task);
+		if (x1s_st != NULL) {
+			printf("x1s exc: %s[%d] exception %d codes 0x%llx 0x%llx pc 0x%llx lr 0x%llx sp 0x%llx far 0x%llx esr 0x%x\n",
+			    x1s_p ? proc_name_address(x1s_p) : "?", task_pid(task), exception,
+			    (unsigned long long)code[0], (unsigned long long)(codeCnt > 1 ? code[1] : 0),
+			    (unsigned long long)get_saved_state_pc(x1s_st), (unsigned long long)get_saved_state_lr(x1s_st),
+			    (unsigned long long)get_saved_state_sp(x1s_st), (unsigned long long)get_saved_state_far(x1s_st),
+			    (unsigned)get_saved_state_esr(x1s_st));
+		}
+	}
+#endif
+
 	if (VM_MAP_PAGE_SIZE(task->map) < PAGE_SIZE) {
 		DEBUG4K_EXC("thread %p task %p map %p exception %d codes 0x%llx 0x%llx\n",
 		    thread, task, task->map, exception, code[0], codeCnt > 1 ? code[1] : 0);
