 	 */
+	/* x1s: before pmap_startup() the VM has no free pages and vm_page_grab() waits (on a wait queue that does not
+	 * exist yet): take the page as pmap_steal_memory() does */
+	if (size == PAGE_SIZE && startup_phase < STARTUP_SUB_KMEM && vm_page_free_count == 0) {
+		/* (only while no page has been released: after that the free list has them all) */
+		ppnum_t pn;
+
+		if (pmap_next_page_hi(&pn, FALSE)) {
+			*pa = (pmap_paddr_t)ptoa(pn);
+			vm_page_wire_count++;
+			vm_page_stolen_count++;
+			bzero((void*)phystokv(*pa), size);
+			return KERN_SUCCESS;
+		}
+	}
